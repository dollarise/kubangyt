{
  "name": "yt-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "desktop:dev": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.81.1",
    "lucide": "0.468.0"
  },
  "devDependencies": {
    "@types/node": "22.15.30",
    "electron": "39.2.7",
    "electron-builder": "26.0.12",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  },
  "build": {
    "appId": "com.dollarise.ytmanager",
    "productName": "YT Manager",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "win": { "target": "nsis" }
  }
}